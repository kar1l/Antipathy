				bf.y = bf.y + bf.vy * dt
				if bf.x > 0.98 then bf.x = 0.98; bf.vx = -math.abs(bf.vx) elseif bf.x < 0.02 then bf.x = 0.02; bf.vx = math.abs(bf.vx) end
				if bf.y > 0.98 then bf.y = 0.98; bf.vy = -math.abs(bf.vy) elseif bf.y < 0.02 then bf.y = 0.02; bf.vy = math.abs(bf.vy) end
				local fx = math.sin(bf.phase * 1.5) * 0.006
				local fy = math.sin(bf.phase * 2.5) * math.cos(bf.phase * 0.8) * 0.004
				bf.body.Position = UDim2.new(bf.x + fx, 0, bf.y + fy, 0)
				bf.body.Rotation = math.sin(bf.phase * 1.5) * 20
				local wf = math.abs(math.sin(bf.wingPhase))
