-- Unified Glitch & Hover Animator (Supports both corner tables and instance elements)
task.spawn(function()
	local glitchTgtColor = Color3.fromRGB(255, 255, 255)
	local updateTimer = 0
	while true do
		task.wait(0.035)
		updateTimer = updateTimer - 0.035
		if updateTimer <= 0 then
			updateTimer = 0.12 + math.random() * 0.18
			local r = math.random(160, 255)
			local g = math.random(160, 255)
			local b = math.random(160, 255)
			glitchTgtColor = Color3.fromRGB(r, g, b)
		end
		currentGlitchColor = currentGlitchColor:Lerp(glitchTgtColor, 0.3)

		for obj, kind in pairs(activeHoveredObjects) do
			if kind == "corners" and typeof(obj) == "table" then
				local hasAny = false
				for _, c in ipairs(obj) do
					if c and c.Parent then
						c.BackgroundColor3 = currentGlitchColor
						hasAny = true
					end
				end
				if not hasAny then activeHoveredObjects[obj] = nil end
			elseif typeof(obj) == "Instance" and obj.Parent then
				if kind == "text" then
					obj.TextColor3 = currentGlitchColor
				elseif kind == "stroke" then
					obj.Color = currentGlitchColor
				elseif kind == "bg" then
					obj.BackgroundColor3 = currentGlitchColor
				end
			else
				activeHoveredObjects[obj] = nil
			end
		end
	end
end)

local function addCornerBorder(parent, color, thickness, cornerLen)
	local corners = {}
	local positions = {
		{UDim2.new(0,0,0,0), UDim2.new(0,cornerLen,0,thickness)}, {UDim2.new(0,0,0,0), UDim2.new(0,thickness,0,cornerLen)},
		{UDim2.new(1,-cornerLen,0,0), UDim2.new(0,cornerLen,0,thickness)}, {UDim2.new(1,-thickness,0,0), UDim2.new(0,thickness,0,cornerLen)},
		{UDim2.new(0,0,1,-thickness), UDim2.new(0,cornerLen,0,thickness)}, {UDim2.new(0,0,1,-cornerLen), UDim2.new(0,thickness,0,cornerLen)},
		{UDim2.new(1,-cornerLen,1,-thickness), UDim2.new(0,cornerLen,0,thickness)}, {UDim2.new(1,-thickness,1,-cornerLen), UDim2.new(0,thickness,0,cornerLen)},
	}
	for _, p in ipairs(positions) do
		local line = Instance.new("Frame")
		line.Name = "CornerLine"
		line.Position = p[1]
		line.Size = p[2]
		line.BackgroundColor3 = color
		line.BorderSizePixel = 0
		line.ZIndex = 500
		line.Parent = parent
		table.insert(corners, line)
	end
	return corners
end

