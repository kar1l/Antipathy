local function makeTopButton(text, posX, posY, colorSet)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 36, 0, 28)
	btn.Position = UDim2.new(0, posX, 0, posY)
	btn.BackgroundColor3 = colorSet.base or Color3.fromRGB(255, 255, 255)
	btn.TextColor3 = colorSet.textColor or Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 16
	btn.Text = text
	btn.ZIndex = 200
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	btn.Parent = topbar
	addCornerBorder(btn, colorSet.stroke, 1, 6)

	local gradient
	if colorSet.gradient then
		gradient = Instance.new("UIGradient")
		gradient.Color = colorSet.gradient
		gradient.Rotation = 90
		gradient.Parent = btn
	end

	btn.MouseEnter:Connect(function()
		if gradient then
			TweenService:Create(gradient, TweenInfo.new(0.12), {Color = colorSet.hoverGradient}):Play()
		elseif colorSet.hoverBase then
			TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = colorSet.hoverBase}):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if gradient then
			TweenService:Create(gradient, TweenInfo.new(0.12), {Color = colorSet.gradient}):Play()
		elseif colorSet.base then
			TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = colorSet.base}):Play()
		end
	end)
	btn.MouseButton1Down:Connect(function() TweenService:Create(btn, TweenInfo.new(0.05), {Size = UDim2.new(0, 32, 0, 24)}):Play() end)
	btn.MouseButton1Up:Connect(function() TweenService:Create(btn, TweenInfo.new(0.05), {Size = UDim2.new(0, 36, 0, 28)}):Play() end)
	return btn
end

