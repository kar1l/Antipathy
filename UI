	lbl.Parent = container

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0.50, 0, 0, 28)
	box.Position = UDim2.new(0.50, 0, 0.5, -14)
	box.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
	box.Text = ""
	box.PlaceholderText = placeholder or ""
	box.PlaceholderColor3 = Color3.fromRGB(80, 80, 90)
	box.Font = Enum.Font.GothamMedium
	box.TextSize = 12
	box.TextColor3 = Color3.fromRGB(230, 230, 235)
	box.ClearTextOnFocus = false
	box.TextXAlignment = Enum.TextXAlignment.Center
	box.ZIndex = 12
	box.Parent = container

	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)
	local bxs = Instance.new("UIStroke")
	bxs.Color = Color3.fromRGB(55, 55, 65)
	bxs.Thickness = 1
	bxs.Parent = box

	box:GetPropertyChangedSignal("Text"):Connect(function()
		local txt = box.Text
		if maxChars and #txt > maxChars then
			box.Text = txt:sub(1, maxChars)
			return
		end
		if numbersOnly then
			local cl = txt:gsub("[^%d.-]", "")
			if cl ~= txt then box.Text = cl end
		end
	end)

	box.Focused:Connect(function()
		TweenService:Create(bxs, TI_FAST, {Color = Color3.fromRGB(180, 180, 190)}):Play()
	end)

	box.FocusLost:Connect(function()
		TweenService:Create(bxs, TI_FAST, {Color = Color3.fromRGB(55, 55, 65)}):Play()
	end)

	container:GetAttributeChangedSignal("FlashError"):Connect(function()
		if container:GetAttribute("FlashError") then
			container:SetAttribute("FlashError", nil)
			task.spawn(function()
				for _ = 1, 2 do
					bxs.Color = Color3.fromRGB(255, 80, 80)
					task.wait(0.12)
					bxs.Color = Color3.fromRGB(55, 55, 65)
					task.wait(0.12)
				end
			end)
		end
	end)

	return box, container
end

local function createSwitch(text, order, parent, defaultState)
	local isOn = defaultState or false
