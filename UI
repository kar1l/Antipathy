local bdx, bdy = 1, 1
local bspeed = 0.15
local bfx, bfy = 16, TOPBAR_H + 16
local blt = 0
local _footerGhost = nil

task.spawn(function()
	while bgFooter.Parent do
		if isClosingAnimation then break end
		local fs = frame.AbsoluteSize
		local textW = bgFooter.TextBounds.X > 0 and bgFooter.TextBounds.X or 220
		local textH = bgFooter.TextBounds.Y > 0 and bgFooter.TextBounds.Y or 18

		if fs.X == 0 then RunService.Heartbeat:Wait(); continue end

		local minX = 12
		local minY = TOPBAR_H + 6
		local maxX = fs.X - TAB_PANEL_W - textW - 12
		local maxY = fs.Y - textH - 6

		bfx = bfx + bspeed * bdx
		bfy = bfy + bspeed * bdy

		local hit = false
		if bfx >= maxX then
			bfx = maxX
			bdx = -1
			hit = true
		elseif bfx <= minX then
			bfx = minX
			bdx = 1
			hit = true
		end

		if bfy >= maxY then
			bfy = maxY
			bdy = -1
			hit = true
		elseif bfy <= minY then
			bfy = minY
			bdy = 1
			hit = true
		end

		if hit then
			bgFooter.TextColor3 = Color3.fromRGB(math.random(150, 255), math.random(150, 255), math.random(150, 255))
		end

		local now = tick()
		if now - blt > 0.15 and not isClosingAnimation then
			blt = now
			if not _footerGhost or not _footerGhost.Parent then
				_footerGhost = Instance.new("TextLabel")
				_footerGhost.BackgroundTransparency = 1
				_footerGhost.AutomaticSize = Enum.AutomaticSize.XY
				_footerGhost.Size = UDim2.new(0, 0, 0, 18)
				_footerGhost.Font = bgFooter.Font
				_footerGhost.ZIndex = 2
				_footerGhost.Parent = frame
			end
			_footerGhost.Text = bgFooter.Text
			_footerGhost.Position = bgFooter.Position
			_footerGhost.TextColor3 = Color3.fromRGB(255, 255, 255)
			_footerGhost.TextTransparency = 0.6
			_footerGhost.TextSize = bgFooter.TextSize + 1
			_footerGhost.Visible = true
			TweenService:Create(_footerGhost, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {TextTransparency = 1}):Play()
		end

		bgFooter.Position = UDim2.new(0, math.floor(bfx), 0, math.floor(bfy))
		RunService.Heartbeat:Wait()
	end
end)

