local function selectTab(targetName)
	for name, tabScroll in pairs(tabs) do
		local isSel = (name == targetName)
		tabScroll.Visible = isSel
		local btn = tabButtons[name]
		local line = tabLines[name]
		local ts = tabStrokes[name]
		if btn then
			btn:SetAttribute("IsActiveTab", isSel)
			local bgImg = btn:FindFirstChild("TabImage")
			if bgImg then bgImg.ImageTransparency = isSel and 0 or 0.7 end
			local lbl = btn:FindFirstChild("Label")
			if lbl then lbl.TextStrokeTransparency = isSel and 0 or 0.5 end
			if ts then ts.Transparency = isSel and 0.3 or 1 end
			if line then line.BackgroundColor3 = isSel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(70, 70, 70) end
		end
	end
end

