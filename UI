	lb.Font = Enum.Font.GothamMedium
	lb.TextSize = 13
	lb.TextXAlignment = Enum.TextXAlignment.Left
	lb.ZIndex = 10
	lb.Parent = c

	local bg = Instance.new("TextButton")
	bg.Size = UDim2.new(0, 34, 0, 18)
	bg.Position = UDim2.new(1, -36, 0.5, -9)
	bg.BackgroundColor3 = isOn and Color3.fromRGB(60, 60, 65) or Color3.fromRGB(25, 25, 28)
	bg.Text = ""
	bg.AutoButtonColor = false
	bg.ZIndex = 11
	bg.Parent = c
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 4)

	local ss = Instance.new("UIStroke")
	ss.Color = isOn and Color3.fromRGB(200, 200, 205) or Color3.fromRGB(75, 75, 80)
	ss.Thickness = 1
	ss.Parent = bg

	local kn = Instance.new("Frame")
	kn.Size = UDim2.new(0, 14, 0, 14)
	kn.Position = isOn and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
	kn.BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 140)
	kn.ZIndex = 12
	kn.Parent = bg
	Instance.new("UICorner", kn).CornerRadius = UDim.new(0, 3)

	local function setSwitch(state)
		isOn = state
		TweenService:Create(kn, TI_NORMAL, {
			Position = isOn and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
			BackgroundColor3 = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 140)
		}):Play()
		TweenService:Create(bg, TI_NORMAL, {
			BackgroundColor3 = isOn and Color3.fromRGB(60, 60, 65) or Color3.fromRGB(25, 25, 28)
		}):Play()
		TweenService:Create(ss, TI_NORMAL, {
			Color = isOn and Color3.fromRGB(200, 200, 205) or Color3.fromRGB(75, 75, 80)
		}):Play()
	end

	bg.MouseButton1Click:Connect(function()
		setSwitch(not isOn)
	end)

	return function() return isOn end, setSwitch
end

local function createActionButton(text, order, parent, colorVariant)
	local btn = Instance.new("TextButton")
	btn.LayoutOrder = order
	btn.Size = UDim2.new(1, 0, 0, 32)
	btn.BackgroundColor3 = colorVariant == "danger" and Color3.fromRGB(26, 16, 16) or Color3.fromRGB(16, 16, 22)
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	btn.ZIndex = 12
	btn.Parent = parent

	local cornerColor = colorVariant == "danger" and Color3.fromRGB(180, 70, 70) or Color3.fromRGB(100, 100, 120)
	local corners = addCornerBorder(btn, cornerColor, 1, 6)

	local grad = Instance.new("UIGradient")
	grad.Color = colorVariant == "danger" and ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(36, 20, 20)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 10, 10))
	} or ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(24, 24, 32)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 12, 16))
	}
	grad.Rotation = 135
	grad.Parent = btn

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Label"
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 13
	lbl.TextColor3 = Color3.fromRGB(240, 240, 245)
	lbl.ZIndex = 13
	lbl.Parent = btn

	btn.MouseEnter:Connect(function()
		local hoverBg = colorVariant == "danger" and Color3.fromRGB(45, 22, 22) or Color3.fromRGB(32, 32, 42)
		TweenService:Create(btn, TI_FAST, {BackgroundColor3 = hoverBg}):Play()
	end)

	btn.MouseLeave:Connect(function()
		local baseBg = colorVariant == "danger" and Color3.fromRGB(26, 16, 16) or Color3.fromRGB(16, 16, 22)
		TweenService:Create(btn, TI_FAST, {BackgroundColor3 = baseBg}):Play()
	end)

	return btn, lbl, corners
end

