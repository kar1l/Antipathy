local function getSuggestion(pfx, autoType)
	if not pfx or #pfx == 0 then return nil end
	pfx = pfx:lower()
	if autoType == "player" then
		for _, p in ipairs(Players:GetPlayers()) do
			local name = p.Name or ""
			if name:lower():sub(1, #pfx) == pfx then return name end
			local dn = p.DisplayName or ""
			if dn:lower():sub(1, #pfx) == pfx then return dn end
			local uid = tostring(p.UserId)
			if uid:sub(1, #pfx) == pfx then return uid end
		end
	elseif autoType == "country" then
		for k, _ in pairs(COUNTRY_ALIASES) do
			if k:lower():sub(1, #pfx) == pfx then return k end
		end
	elseif autoType == "device" then
		for _, dev in ipairs({"PC", "Mobile", "Console", "Tablet"}) do
			if dev:lower():sub(1, #pfx) == pfx then return dev end
		end
	elseif autoType == "ability" then
		for k, _ in pairs(DEFAULT_ABILITY_IMAGES) do
			if k:lower():sub(1, #pfx) == pfx then return k end
		end
	end
	return nil
end

local function createTextBox(text, order, parent, placeholder, maxChars, numbersOnly, autoType)
	local c = Instance.new("Frame"); c.LayoutOrder = order; c.Size = UDim2.new(1,0,0,32); c.BackgroundTransparency = 1; c.ZIndex = 10; c.Parent = parent
	local lb = Instance.new("TextLabel"); lb.BackgroundTransparency = 1; lb.Size = UDim2.new(0.52,0,1,0); lb.Text = text; lb.TextColor3 = Color3.fromRGB(210,210,215); lb.Font = Enum.Font.GothamMedium; lb.TextSize = 14; lb.TextXAlignment = Enum.TextXAlignment.Left; lb.ZIndex = 10; lb.Parent = c
	
	local boxHolder = Instance.new("Frame")
	boxHolder.Size = UDim2.new(0.44, 0, 0, 26)
	boxHolder.Position = UDim2.new(0.56, 0, 0.5, -13)
	boxHolder.BackgroundColor3 = Color3.fromRGB(6, 6, 8)
	boxHolder.BorderSizePixel = 0
	boxHolder.ZIndex = 11
	boxHolder.Parent = c
	Instance.new("UICorner", boxHolder).CornerRadius = UDim.new(0, 4)

	local defaultCornerCol = Color3.fromRGB(65, 65, 75)
	local boxCorners = addCornerBorder(boxHolder, defaultCornerCol, 1, 4)

	local ghost = Instance.new("TextLabel")
	ghost.Size = UDim2.new(1, -8, 1, 0)
	ghost.Position = UDim2.new(0, 4, 0, 0)
	ghost.BackgroundTransparency = 1
	ghost.Font = Enum.Font.GothamMedium
	ghost.TextSize = 13
	ghost.TextColor3 = Color3.fromRGB(105, 110, 125)
	ghost.TextXAlignment = Enum.TextXAlignment.Center
	ghost.Visible = false
	ghost.ZIndex = 11
	ghost.Parent = boxHolder

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 1, 0)
	box.BackgroundTransparency = 1
	box.Text = ""
	box.PlaceholderText = placeholder or ""
	box.PlaceholderColor3 = Color3.fromRGB(75, 75, 85)
	box.Font = Enum.Font.GothamMedium
	box.TextSize = 13
	box.TextColor3 = Color3.fromRGB(230, 230, 235)
	box.ClearTextOnFocus = false
	box.TextXAlignment = Enum.TextXAlignment.Center
	box.ZIndex = 12
	box.Parent = boxHolder

	local isFocused = false

	local function updateGhost()
		if not autoType or not isFocused then ghost.Visible = false; return end
		local t = box.Text or ""
		if #t == 0 then ghost.Visible = false; return end
		local sugg = getSuggestion(t, autoType)
		if not sugg or sugg:lower() == t:lower() then
			ghost.Visible = false
			return
		end
		ghost.Text = t .. sugg:sub(#t + 1)
		ghost.Visible = true
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		local txt = box.Text
		if maxChars and #txt > maxChars then box.Text = txt:sub(1, maxChars); return end
		if numbersOnly then local cl = txt:gsub("[^%d.-]", ""); if cl ~= txt then box.Text = cl end end
		updateGhost()
	end)

	box.Focused:Connect(function()
		isFocused = true
		activeHoveredObjects[boxCorners] = "corners"
		updateGhost()
	end)

	box.FocusLost:Connect(function(enterPressed)
		isFocused = false
		activeHoveredObjects[boxCorners] = nil
		ghost.Visible = false
		if enterPressed and autoType then
			local t = box.Text or ""
			local sugg = getSuggestion(t, autoType)
			if sugg and sugg:lower():sub(1, #t) == t:lower() then
				box.Text = sugg
			end
		end
		for _, bc in ipairs(boxCorners) do
			TweenService:Create(bc, TI_FAST, {BackgroundColor3 = defaultCornerCol}):Play()
		end
	end)

	boxHolder.MouseEnter:Connect(function()
		activeHoveredObjects[boxCorners] = "corners"
	end)

	boxHolder.MouseLeave:Connect(function()
		if not isFocused then
			activeHoveredObjects[boxCorners] = nil
			for _, bc in ipairs(boxCorners) do
				TweenService:Create(bc, TI_FAST, {BackgroundColor3 = defaultCornerCol}):Play()
			end
		end
	end)

	c:GetAttributeChangedSignal("FlashError"):Connect(function()
		if c:GetAttribute("FlashError") then
			c:SetAttribute("FlashError", nil)
			task.spawn(function()
				for _ = 1, 2 do
					for _, bc in ipairs(boxCorners) do
						bc.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
					end
					task.wait(0.12)
					for _, bc in ipairs(boxCorners) do
						bc.BackgroundColor3 = defaultCornerCol
					end
					task.wait(0.12)
				end
			end)
		end
	end)

	return c, box
end

