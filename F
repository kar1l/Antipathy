local function notify(title, text, duration)
	local notifData = {
		Title = title or "Antipathy",
		Text = text or "",
		Duration = duration or 4
	}
	pcall(StarterGui.SetCore, StarterGui, "SendNotification", notifData)
end

local UI = nil
if _genv.AntipathyUI and typeof(_genv.AntipathyUI) == "table" and _genv.AntipathyUI.applyButton then
	UI = _genv.AntipathyUI
	_genv.AntipathyUI = nil
else
	local targetUrl = _genv.AntipathyUI_URL or UI_URL
	local uiSource = nil
	for attempt = 1, 3 do
		local ok, res = pcall(function()
			return game:HttpGet(targetUrl)
		end)
		if ok and res and #res > 0 then
			uiSource = res
			break
		end
		task.wait(0.4 * attempt)
	end

	if not uiSource then
		local errMsg = "Failed to download UI from: " .. tostring(targetUrl)
		warn("[Antipathy] " .. errMsg)
		notify("Antipathy", "Failed to download UI from GitHub", 5)
		return
	end

	local fn, err = loadstring(uiSource)
	if not fn then
		local errMsg = "UI compilation error: " .. tostring(err)
		warn("[Antipathy] " .. errMsg)
		notify("Antipathy", "UI compilation error", 5)
		return
	end

	local okExec, resUi = pcall(fn)
	if not okExec or not resUi or typeof(resUi) ~= "table" then
		local errMsg = "UI runtime error: " .. tostring(resUi)
		warn("[Antipathy] " .. errMsg)
		notify("Antipathy", "UI initialization error", 5)
		return
	end

	UI = resUi
end

if not UI or not UI.applyButton then
	warn("[Antipathy] UI exports missing or incomplete.")
	notify("Antipathy", "UI exports missing", 5)
	return
end

