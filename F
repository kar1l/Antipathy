local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
if playerGui then
	playerGui.DescendantAdded:Connect(function(desc)
		if not profileSpoofState.hudActive then return end
		task.defer(function()
			if not desc or not desc.Parent then return end
			local dName = desc.Name:lower()
			if profileSpoofState.activeCoins and (dName:find("money") or dName:find("coin") or dName:find("cash") or dName:find("amount")) then
				local moneyLabels = findHudMoneyLabels()
				for i, label in ipairs(moneyLabels) do
					local key = "hudMoney_" .. i
					if not profileSpoofState.hudFieldConns[key] then
						lockDynamicNumberElement(label, profileSpoofState.activeCoins, profileSpoofState.hudOriginals, profileSpoofState.hudConns, profileSpoofState.hudFieldConns, profileSpoofState.hudOffsets, key)
					end
				end
			end
			if profileSpoofState.activeTokens and (dName:find("token") or dName:find("currency")) then
				local tokenLabels = findTradeTokenLabels()
				for i, label in ipairs(tokenLabels) do
					local key = "tradeToken_" .. i
					if not profileSpoofState.hudFieldConns[key] then
						lockDynamicNumberElement(label, profileSpoofState.activeTokens, profileSpoofState.hudOriginals, profileSpoofState.hudConns, profileSpoofState.hudFieldConns, profileSpoofState.hudOffsets, key)
					end
				end
			end
		end)
	end)
end

