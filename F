local function applyHudCurrency(coinsText, tokensText)
	coinsText = trimText(coinsText)
	tokensText = trimText(tokensText)
	if coinsText == "" and tokensText == "" then return true end

	local originals = profileSpoofState.hudOriginals
	local conns = profileSpoofState.hudConns
	local fieldConns = profileSpoofState.hudFieldConns
	local offsets = profileSpoofState.hudOffsets
	local applied = false

	if coinsText ~= "" then
		local moneyLabels = findHudMoneyLabels()
		for i, label in ipairs(moneyLabels) do
			lockDynamicNumberElement(label, coinsText, originals, conns, fieldConns, offsets, "hudMoney_" .. i)
			applied = true
		end
	end

	if tokensText ~= "" then
		local tokenLabels = findTradeTokenLabels()
		for i, label in ipairs(tokenLabels) do
			lockDynamicNumberElement(label, tokensText, originals, conns, fieldConns, offsets, "tradeToken_" .. i)
			applied = true
		end
	end

	profileSpoofState.hudActive = true
	if coinsText ~= "" then profileSpoofState.activeCoins = coinsText end
	if tokensText ~= "" then profileSpoofState.activeTokens = tokensText end
	return applied
end

local function revertHudCurrency()
	for _, conn in ipairs(profileSpoofState.hudConns) do
		pcall(function() conn:Disconnect() end)
	end
	profileSpoofState.hudConns = {}
	profileSpoofState.hudFieldConns = {}

	local moneyLabels = findHudMoneyLabels()
	for i, label in ipairs(moneyLabels) do
		local key = "hudMoney_" .. i
		if profileSpoofState.hudOriginals[key] then
			pcall(function() label.Text = profileSpoofState.hudOriginals[key] end)
		end
	end

	local tokenLabels = findTradeTokenLabels()
	for i, label in ipairs(tokenLabels) do
		local key = "tradeToken_" .. i
		if profileSpoofState.hudOriginals[key] then
			pcall(function() label.Text = profileSpoofState.hudOriginals[key] end)
		end
	end

	profileSpoofState.hudOriginals = {}
	profileSpoofState.hudOffsets = {}
	profileSpoofState.hudActive = false
	profileSpoofState.activeCoins = nil
	profileSpoofState.activeTokens = nil
	return true
end

local cachedDummyModels = {}

local function clearAccessories(character)
	if not character then return end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Accessory") then
			pcall(function()
				local handle = child:FindFirstChild("Handle")
				if handle then handle.Transparency = 1 end
				child:Destroy()
			end)
		end
	end
end

local function getOrCreateDummyModel(description, rigType, userId)
	if userId and cachedDummyModels[userId] then
		local cached = cachedDummyModels[userId]
		local ok, copy = pcall(function() return cached:Clone() end)
		if ok and copy and #copy:GetChildren() > 0 then
			return copy
		end
	end

	local dummyModel = nil
	local backoffDelays = {0.2, 0.5, 1.0}
	for i = 1, 3 do
		local ok, err = pcall(function()
			dummyModel = Players:CreateHumanoidModelFromDescription(description, rigType)
		end)
		if dummyModel and #dummyModel:GetChildren() > 0 then break end
		if dummyModel then dummyModel:Destroy() end
		dummyModel = nil
		local delay = backoffDelays[i] or 0.5
		if not ok and err and (tostring(err):find("429") or tostring(err):lower():find("rate")) then
			delay = delay * 2
		end
		task.wait(delay)
	end

	if dummyModel and userId then
		pcall(function()
			local template = dummyModel:Clone()
			template.Parent = nil
			cachedDummyModels[userId] = template
		end)
	end

	return dummyModel
end

local function applyDescriptionCustom(character, description, sourceUserId)
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return false end
	local rigType = humanoid.RigType or Enum.HumanoidRigType.R6
	local dummyModel = getOrCreateDummyModel(description, rigType, sourceUserId)

	if not dummyModel then
		pcall(function() humanoid:ApplyDescription(description) end)
		return false
	end

	clearAccessories(character)
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child:Destroy()
		end
	end

	local dummyBC = dummyModel:FindFirstChildOfClass("BodyColors")
	if dummyBC then
		local bc = character:FindFirstChildOfClass("BodyColors")
		if bc then bc:Destroy() end
		dummyBC:Clone().Parent = character
	end

	for _, child in ipairs(dummyModel:GetChildren()) do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child:Clone().Parent = character
		end
	end

	local dummyHead = dummyModel:FindFirstChild("Head")
	local playerHead = character:FindFirstChild("Head")
	if dummyHead and playerHead then
		for _, child in ipairs(playerHead:GetChildren()) do
			if child:IsA("Decal") or child:IsA("Texture") or child:IsA("SpecialMesh") or 
			   child:IsA("FaceControls") or child:IsA("SurfaceAppearance") or 
			   child:IsA("WrapTarget") or child:IsA("WrapLayer") then
				child:Destroy()
			end
		end

		for _, child in ipairs(dummyHead:GetChildren()) do
			if child:IsA("Decal") or child:IsA("Texture") then
				child:Clone().Parent = playerHead
			end
		end

		local dummyHeadMesh = dummyHead:FindFirstChildOfClass("SpecialMesh")
		local playerHeadMesh = playerHead:FindFirstChildOfClass("SpecialMesh")
		if dummyHeadMesh then
			if playerHeadMesh then
				pcall(function()
					playerHeadMesh.MeshId = dummyHeadMesh.MeshId
					playerHeadMesh.TextureId = dummyHeadMesh.TextureId
					playerHeadMesh.Scale = dummyHeadMesh.Scale
					playerHeadMesh.Offset = dummyHeadMesh.Offset
				end)
			else
				dummyHeadMesh:Clone().Parent = playerHead
			end
		end
	end

	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("CharacterMesh") then
			child:Destroy()
		end
	end
	for _, child in ipairs(dummyModel:GetChildren()) do
		if child:IsA("CharacterMesh") then
			child:Clone().Parent = character
		end
	end

	for _, child in ipairs(dummyModel:GetChildren()) do
		if child:IsA("Accessory") then
			pcall(function()
				local acc = child:Clone()
				local handle = acc:FindFirstChild("Handle")
				if not handle then return end
				for _, w in ipairs(handle:GetChildren()) do
					if w:IsA("Weld") or w:IsA("Motor6D") or w:IsA("WeldConstraint") then
						w:Destroy()
					end
				end

				local handleAttachment = nil
				for _, att in ipairs(handle:GetChildren()) do
					if att:IsA("Attachment") then
						handleAttachment = att
						break
					end
				end

				acc.Parent = character
				if handleAttachment then
					local targetPart = nil
					local targetAttachment = nil
					for _, desc in ipairs(character:GetDescendants()) do
						if desc:IsA("Attachment") and desc.Name == handleAttachment.Name and desc.Parent ~= handle then
							targetPart = desc.Parent
							targetAttachment = desc
							break
						end
					end

					if targetPart and targetAttachment then
						local weld = Instance.new("Weld")
						weld.Part0 = targetPart
						weld.Part1 = handle
						weld.C0 = targetAttachment.CFrame
						weld.C1 = handleAttachment.CFrame
						weld.Parent = handle
					end
				else
					local head = character:FindFirstChild("Head")
					if head then
						local weld = Instance.new("Weld")
						weld.Part0 = head
						weld.Part1 = handle
						weld.C1 = acc.AttachmentPoint
						weld.Parent = handle
					end
				end

				handle.Anchored = false
			end)
		end
	end
	dummyModel:Destroy()
	return true
end

local function applyIdentitySpoofing(target, sourceUserId, spoofUserIdProperty, namesOnly)
	local saved = modifiedPlayers[target]
	if not saved then return false end
	local sourceName, sourceDisplayName = cachedGetSourceNames(sourceUserId)
	if not sourceName then return false end

	saved.sourceUserId = sourceUserId
	saved.sourceName = sourceName
	saved.sourceDisplayName = sourceDisplayName
	local cachedOriginalName = saved.originalName or target.Name
	local cachedOriginalDisplayName = saved.originalDisplayName or target.DisplayName
	local fakeUsername = sourceName
	local fakeDisplayName = sourceDisplayName

	if saved.identityConns then
		for _, c in ipairs(saved.identityConns) do pcall(function() c:Disconnect() end) end
	end
	saved.identityConns = {}

	if not saved.originalName then saved.originalName = cachedOriginalName end
	if not saved.originalUserId then saved.originalUserId = target.UserId end
	if not saved.originalCharAppearance then
		pcall(function() saved.originalCharAppearance = target.CharacterAppearance end)
	end
	if spoofUserIdProperty then
		setProp(target, "UserId", sourceUserId)
	end

	task.spawn(function()
		task.wait(0.3)
		local origId = saved.originalUserId or target.UserId
		for i = 1, 6 do
			renamePlayerListFrame(origId, fakeUsername)
			if saved.robloxPlus then
				applyRobloxPlusBadge(origId, true, saved)
			end
			task.wait(0.8)
		end
	end)

	local character = target.Character
	if character then
		local humanoid = character:FindFirstChild("Humanoid")
		if humanoid then
			pcall(function() humanoid.DisplayName = fakeDisplayName end)
		end
	end

	if character then
		for _, part in ipairs({character:FindFirstChild("Head"), character:FindFirstChild("HumanoidRootPart")}) do
			if part then
				for _, child in ipairs(part:GetChildren()) do
					if child:IsA("BillboardGui") then
						for _, descendant in ipairs(child:GetDescendants()) do
							if descendant:IsA("TextLabel") then
								local t = descendant.Text
								if t == cachedOriginalName or t == cachedOriginalDisplayName then
									descendant.Text = fakeDisplayName
								end
							end
						end
					end
				end
			end
		end
	end

	pcall(function()
		local origInspectFunc = GuiService.InspectPlayerFromHumanoidDescription
		if origInspectFunc then
			GuiService.InspectPlayerFromHumanoidDescription = function(humanoidDesc, displayName)
				if displayName == fakeUsername or displayName == fakeDisplayName or
				   displayName == cachedOriginalName or displayName == cachedOriginalDisplayName then
					local sDesc = cachedGetDescription(sourceUserId)
					if sDesc then
						pcall(function() origInspectFunc(sDesc, fakeDisplayName) end)
						return
					end
				end
				return origInspectFunc(humanoidDesc, displayName)
			end
			table.insert(saved.identityConns, {Disconnect = function() GuiService.InspectPlayerFromHumanoidDescription = origInspectFunc end})
		end

		local origInspectId = GuiService.InspectPlayerFromUserId
		if origInspectId then
			GuiService.InspectPlayerFromUserId = function(userId)
				if tonumber(userId) == tonumber(target.UserId) or tonumber(userId) == tonumber(saved.originalUserId) then
					pcall(function() origInspectId(tonumber(sourceUserId)) end)
					return
				end
				return origInspectId(userId)
			end
			table.insert(saved.identityConns, {Disconnect = function() GuiService.InspectPlayerFromUserId = origInspectId end})
		end
	end)

	if saved.robloxPlus then
		local entry = findPlayerEntry(saved.originalUserId or target.UserId)
		if entry then
			for _, desc in ipairs(entry:GetDescendants()) do
				local dName = desc.Name:lower()
				if dName:find("premium") or dName:find("badge") or dName:find("icon") or dName:find("plus") or dName:find("vip") or dName:find("verified") then
					pcall(function()
						desc.Visible = true
						if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then desc.ImageTransparency = 0 end
					end)
				end
			end
		end
	end

	local targetIdStr = tostring(saved.originalUserId or target.UserId)
	local sourceIdStr = tostring(sourceUserId)

	local function updateTextElement(element)
		if _isUpdating then return end
		if not element or not element.Parent then return end
		if not (element:IsA("TextLabel") or element:IsA("TextButton")) then return end
		local text = element.Text
		if not text or text == "" then return end
		local textTrimmed = text:gsub("^%s+", ""):gsub("%s+$", "")
		_isUpdating = true
		if textTrimmed == cachedOriginalDisplayName or text == cachedOriginalDisplayName then
			element.Text = fakeDisplayName
			_isUpdating = false
			return
		end
		if textTrimmed == cachedOriginalName or text == cachedOriginalName then
			element.Text = fakeDisplayName
			_isUpdating = false
			return
		end

		local atOrig = "@" .. cachedOriginalName
		local atFake = "@" .. fakeUsername
		if textTrimmed == atOrig or text == atOrig then
			element.Text = atFake
			_isUpdating = false
			return
		end
		if text:find(cachedOriginalDisplayName, 1, true) then
			element.Text = text:gsub(cachedOriginalDisplayName, fakeDisplayName)
			_isUpdating = false
			return
		end
		if text:find(cachedOriginalName, 1, true) then
			element.Text = text:gsub(atOrig, atFake):gsub(cachedOriginalName, fakeUsername)
			_isUpdating = false
			return
		end
		_isUpdating = false
	end

	local function replaceAvatarImageUrl(el)
		if _isUpdating then return end
		if not el or not el.Parent then return end
		if not (el:IsA("ImageLabel") or el:IsA("ImageButton")) then return end
		local img = el.Image
		if img and img ~= "" and img:find(targetIdStr, 1, true) then
			local newImg = img:gsub(targetIdStr, sourceIdStr)
			if newImg ~= img then
				_isUpdating = true
				el.Image = newImg
				_isUpdating = false
			end
		end
	end

	local function setupTextListener(element)
		if element:IsA("TextLabel") or element:IsA("TextButton") then
			updateTextElement(element)
			local textConn = element:GetPropertyChangedSignal("Text"):Connect(function()
				if not _isUpdating then updateTextElement(element) end
			end)
			table.insert(saved.identityConns, textConn)
		end
	end

	local function setupImageListener(element)
		if element:IsA("ImageLabel") or element:IsA("ImageButton") then
			replaceAvatarImageUrl(element)
			local imgConn = element:GetPropertyChangedSignal("Image"):Connect(function()
				if not _isUpdating then
					task.defer(function() replaceAvatarImageUrl(element) end)
				end
			end)
			table.insert(saved.identityConns, imgConn)
		end
	end

	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local _processedElements = {}

	local function fastScanContainer(container)
		if not container then return end
		for _, desc in ipairs(container:GetDescendants()) do
			if desc:IsA("TextLabel") or desc:IsA("TextButton") then
				setupTextListener(desc)
				_processedElements[desc] = true
			elseif not namesOnly and (desc:IsA("ImageLabel") or desc:IsA("ImageButton")) then
				setupImageListener(desc)
				_processedElements[desc] = true
			end
		end
	end

	fastScanContainer(CoreGui:FindFirstChild("PlayerList"))
	if playerGui then
		fastScanContainer(playerGui:FindFirstChild("HUD"))
		fastScanContainer(playerGui:FindFirstChild("MainHud"))
	end

	for _, gui in ipairs({playerGui, CoreGui}) do
		if gui then
			task.spawn(function()
				local descendants = gui:GetDescendants()
				for i = 1, #descendants do
					local desc = descendants[i]
					if not _processedElements[desc] then
						if desc:IsA("TextLabel") or desc:IsA("TextButton") then
							setupTextListener(desc)
							_processedElements[desc] = true
						elseif not namesOnly and (desc:IsA("ImageLabel") or desc:IsA("ImageButton")) then
							setupImageListener(desc)
							_processedElements[desc] = true
						end
					end
					if i % 300 == 0 then task.wait() end
				end
			end)

			local addedConn = gui.DescendantAdded:Connect(function(desc)
				if _processedElements[desc] then return end
				_processedElements[desc] = true
				task.defer(function()
					if not desc or not desc.Parent then return end
					if desc:IsA("TextLabel") or desc:IsA("TextButton") then
						setupTextListener(desc)
					elseif not namesOnly and (desc:IsA("ImageLabel") or desc:IsA("ImageButton")) then
						setupImageListener(desc)
					end
				end)
			end)
			table.insert(saved.identityConns, addedConn)
		end
	end

	return true
end

local function spoofLeaderstats(target, wins, elims, noScale)
	local saved = modifiedPlayers[target]
	if not saved then
		saved = {
			originalName = target.Name,
			originalDisplayName = target.DisplayName,
			originalUserId = target.UserId
		}
		modifiedPlayers[target] = saved
	end

	wins = trimText(wins)
	elims = trimText(elims)
	if wins == "" and elims == "" then return end

	saved.statConns = saved.statConns or {}
	saved.statOriginals = saved.statOriginals or {}
	saved.statOffsets = saved.statOffsets or {}

	local function attachToStat(stat, desiredStr)
		if not stat or not desiredStr or desiredStr == "" then return end
		local desired = tonumber(desiredStr)
		if not desired then return end

		if saved.statOriginals[stat.Name] == nil then
			saved.statOriginals[stat.Name] = stat.Value
		end
		local offset = desired - (tonumber(stat.Value) or 0)
		saved.statOffsets[stat.Name] = offset
		pcall(function() stat.Value = desired end)
		local lastSpoofed = desired

		local conn = stat:GetPropertyChangedSignal("Value"):Connect(function()
			if noScale then
				local cur = tonumber(stat.Value)
				if cur ~= desired then
					task.defer(function() pcall(function() stat.Value = desired end) end)
				end
			else
				local off = saved.statOffsets and saved.statOffsets[stat.Name]
				if not off then return end
				local val = tonumber(stat.Value)
				if not val or val == lastSpoofed then return end
				local newSpoofed = val + off
				lastSpoofed = newSpoofed
				task.defer(function() pcall(function() stat.Value = newSpoofed end) end)
			end
		end)
		table.insert(saved.statConns, conn)
	end

	local function setupStats(ls)
		attachToStat(ls:FindFirstChild("Wins"), wins)
		local elimStat = ls:FindFirstChild("Elims") or ls:FindFirstChild("Eliminations") or ls:FindFirstChild("Kills")
		attachToStat(elimStat, elims)
	end

	local ls = target:FindFirstChild("leaderstats")
	if ls then setupStats(ls) end
	local conn = target.ChildAdded:Connect(function(child)
		if child.Name == "leaderstats" then
			task.wait(0.1)
			setupStats(child)
		end
	end)
	table.insert(saved.statConns, conn)
end

local function revertIdentitySpoofing(target, saved)
	if not saved then return end
	if saved.statConns then
		for _, c in ipairs(saved.statConns) do pcall(function() c:Disconnect() end) end
		saved.statConns = nil
	end
	if saved.statOriginals and target:FindFirstChild("leaderstats") then
		local ls = target.leaderstats
		for statName, origVal in pairs(saved.statOriginals) do
			local stat = ls:FindFirstChild(statName)
			if stat then pcall(function() stat.Value = origVal end) end
		end
	end
	saved.statOriginals = nil
	saved.statOffsets = nil

	if saved.identityConns then
		for _, conn in ipairs(saved.identityConns) do pcall(function() conn:Disconnect() end) end
		saved.identityConns = nil
	end

	local origUserId = saved.originalUserId or target.UserId
	local origEntryName = "PlayerEntry_" .. tostring(origUserId)
	pcall(function() renamePlayerListFrame(origUserId, origEntryName) end)
	if saved.robloxPlus then
		pcall(function() applyRobloxPlusBadge(origUserId, false, saved) end)
	end

	setProp(target, "CharacterAppearanceId", saved.originalCharAppearanceId or origUserId)
	setProp(target, "userId", origUserId)
	setProp(target, "UserId", origUserId)
	if saved.originalCharAppearance then
		setProp(target, "CharacterAppearance", saved.originalCharAppearance)
	end

	local character = target.Character
	if character then
		local humanoid = character:FindFirstChild("Humanoid")
		if humanoid then
			pcall(function()
				humanoid.DisplayName = saved.originalHumanoidDisplayName or saved.originalDisplayName or target.DisplayName
			end)
		end
	end

	if saved.sourceName then
		local sourceIdStr = tostring(saved.sourceUserId or "")
		local targetIdStr = tostring(origUserId)
		for _, gui in ipairs({LocalPlayer:FindFirstChild("PlayerGui"), CoreGui}) do
			if gui then
				local origDispName = saved.originalDisplayName or target.DisplayName
				local origUsername = saved.originalName or target.Name
				for _, desc in ipairs(gui:GetDescendants()) do
					if desc:IsA("TextLabel") or desc:IsA("TextButton") then
						local text = desc.Text
						if text and text ~= "" then
							if text == saved.sourceDisplayName then
								desc.Text = origDispName
							elseif text == saved.sourceName then
								desc.Text = origUsername
							elseif text == "@" .. saved.sourceName then
								desc.Text = "@" .. origUsername
							elseif text:find(saved.sourceDisplayName, 1, true) then
								desc.Text = text:gsub(saved.sourceDisplayName, origDispName)
							end
						end
					elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
						local img = desc.Image
						if img and sourceIdStr ~= "" and img:find(sourceIdStr, 1, true) then
							desc.Image = img:gsub(sourceIdStr, targetIdStr)
						end
					end
				end
			end
		end
	end

	if character then
		for _, part in ipairs({character:FindFirstChild("Head"), character:FindFirstChild("HumanoidRootPart")}) do
			if part then
				for _, child in ipairs(part:GetChildren()) do
					if child:IsA("BillboardGui") then
						for _, descendant in ipairs(child:GetDescendants()) do
							if descendant:IsA("TextLabel") then
								local t = descendant.Text
								if t == saved.sourceDisplayName or t == saved.sourceName then
									descendant.Text = saved.originalDisplayName or target.DisplayName
								end
							end
						end
					end
				end
			end
		end
	end
end

local function revertPlayer(target)
	local saved = modifiedPlayers[target]
	local character = target and target.Character
	local restoreDesc = (saved and saved.description) or (target and cachedGetDescription(target.UserId))

	if saved and saved.charAddedConn then
		pcall(function() saved.charAddedConn:Disconnect() end)
		saved.charAddedConn = nil
	end

	if character and restoreDesc then
		pcall(function()
			applyDescriptionCustom(character, restoreDesc, (saved and saved.originalUserId) or (target and target.UserId))
		end)
	end

	if saved then
		revertIdentitySpoofing(target, saved)
		modifiedPlayers[target] = nil
	end
	return true
end

local function executeFraming(sourceText, targetText, winsText, elimText, options)
	sourceText = trimText(sourceText or "")
	targetText = trimText(targetText or "")

	if targetText == "" then
		setStatus("Enter Target's UserID or Username.", Color3.fromRGB(255, 200, 120))
		return { success = false, message = "No target provided" }
	end

	local target = getTargetPlayer(targetText)
	if not target then
		setStatus("Target not found: " .. targetText, Color3.fromRGB(255, 120, 120))
		return { success = false, message = "Target not found" }
	end

	local targetChar = target.Character
	if not targetChar then
		setStatus("Waiting for " .. target.Name .. "'s character...", Color3.fromRGB(255, 200, 80))
		local t0 = tick()
		repeat task.wait(0.2); targetChar = target.Character until targetChar or (tick() - t0 > 8)
	end
	if targetChar and not targetChar:FindFirstChild("Humanoid") then
		local t0 = tick()
		repeat task.wait(0.2) until targetChar:FindFirstChild("Humanoid") or (tick() - t0 > 6)
	end

	local saved = modifiedPlayers[target]
	if not saved then
		local hum = targetChar and targetChar:FindFirstChild("Humanoid")
		local savedDesc = nil
		if hum then
			for i = 1, 3 do
				pcall(function() savedDesc = hum:GetAppliedDescription() end)
				if savedDesc then break end
				task.wait(0.2)
			end
		end
		if not savedDesc then
			savedDesc = cachedGetDescription(target.UserId)
		end
		modifiedPlayers[target] = {
			description = savedDesc,
			originalName = target.Name,
			originalDisplayName = target.DisplayName,
			originalHumanoidDisplayName = (hum and hum.DisplayName) or target.DisplayName,
			originalUserId = target.UserId,
			originalCharAppearanceId = nil,
			originalCharAppearance = nil,
			sourceUserId = nil,
			sourceName = nil,
			sourceDisplayName = nil,
			robloxPlus = options and options.robloxPlus or false,
			charAddedConn = nil,
			identityConns = nil
		}
		saved = modifiedPlayers[target]
	end

	local sourceUserId = nil
	if sourceText ~= "" then
		sourceUserId = resolveUserId(sourceText)
	end

	if options and options.robloxPlus ~= nil then
		saved.robloxPlus = options.robloxPlus
		local tId = saved.originalUserId or target.UserId
		if saved.robloxPlus then
			task.spawn(function()
				for i = 1, 8 do
					applyRobloxPlusBadge(tId, true, saved)
					task.wait(0.5)
				end
			end)
		else
			applyRobloxPlusBadge(tId, false, saved)
		end
	end

	if sourceUserId then
		saved.sourceUserId = sourceUserId
		if targetChar and not options.namesOnly then
			task.spawn(function()
				local desc = cachedGetDescription(sourceUserId)
				if desc then applyDescriptionCustom(targetChar, desc, sourceUserId) end
			end)
		end

		if saved.charAddedConn then saved.charAddedConn:Disconnect() end
		saved.charAddedConn = target.CharacterAdded:Connect(function(newChar)
			local s = modifiedPlayers[target]
			if not s or not s.sourceUserId then return end

			clearAccessories(newChar)

			local h = newChar:WaitForChild("Humanoid", 10)
			if not h then return end
			task.spawn(function()
				pcall(function()
					local desc = cachedGetDescription(s.sourceUserId)
					for i = 1, 3 do
						if desc and not options.namesOnly then
							applyDescriptionCustom(newChar, desc, s.sourceUserId)
						end
						if s.sourceDisplayName then h.DisplayName = s.sourceDisplayName end
						task.wait(0.4)
					end
				end)
			end)
		end)

		task.spawn(function()
			for i = 1, 8 do
				local ok = applyIdentitySpoofing(target, sourceUserId, options.changeUserId, options.namesOnly)
				if ok then break end
				task.wait(1)
			end
		end)
	end

	if winsText ~= "" or elimText ~= "" then
		spoofLeaderstats(target, winsText, elimText, options and options.noScale)
	end

	local sName = sourceUserId and (cachedGetSourceNames(sourceUserId) or sourceText) or nil
	local msg = sName and string.format("Framed %s as %s", target.Name, sName) or ("Framed stats for " .. target.Name)
	setStatus(msg, Color3.fromRGB(120, 255, 120))
	return { success = true, message = msg }
end

applyButton.MouseButton1Click:Connect(function()
	executeFraming(sourceBox.Text, targetBox.Text, winsBox.Text, elimBox.Text, {
		robloxPlus = getFrameRobloxPlus and getFrameRobloxPlus(),
		changeUserId = getFrameChangeUserId(),
		namesOnly = getFrameNamesOnly(),
		noScale = getFrameNoScale and getFrameNoScale()
	})
end)

revertButton.MouseButton1Click:Connect(function()
	local targetText = trimText(targetBox.Text)
	if targetText ~= "" then
		local target = getTargetPlayer(targetText)
		if target then
			revertPlayer(target)
			setStatus("Reverted " .. target.Name, Color3.fromRGB(120, 255, 120))
			return
		end
	end
	for p, _ in pairs(modifiedPlayers) do
		if p ~= LocalPlayer then revertPlayer(p) end
	end
	setStatus("Reverted all targets", Color3.fromRGB(200, 200, 200))
end)

spoofButton.MouseButton1Click:Connect(function()
	local sourceInput = trimText(selfSourceBox.Text)
	local winsText = trimText(selfWinsBox.Text)
	local elimText = trimText(selfElimBox.Text)
	local coinsText = trimText(selfCoinsBox.Text)
	local tokensText = trimText(selfTokensBox.Text)
	local noScale = getSelfNoScale and getSelfNoScale()
	local robloxPlus = getSelfRobloxPlus and getSelfRobloxPlus()

	local saved = modifiedPlayers[LocalPlayer]
	if not saved then
		local character = LocalPlayer.Character
		local hum = character and character:FindFirstChild("Humanoid")
		local savedDesc = nil
		if hum then
			pcall(function() savedDesc = hum:GetAppliedDescription() end)
		end
		if not savedDesc then
			savedDesc = cachedGetDescription(LocalPlayer.UserId)
		end
		modifiedPlayers[LocalPlayer] = {
			description = savedDesc,
			originalName = LocalPlayer.Name,
			originalDisplayName = LocalPlayer.DisplayName,
			originalHumanoidDisplayName = hum and hum.DisplayName or LocalPlayer.DisplayName,
			originalUserId = LocalPlayer.UserId,
			sourceUserId = nil,
			sourceName = nil,
			sourceDisplayName = nil,
			robloxPlus = robloxPlus or false,
			charAddedConn = nil,
			identityConns = {}
		}
		saved = modifiedPlayers[LocalPlayer]
	end

	saved.robloxPlus = robloxPlus or false

	if robloxPlus then
		task.spawn(function()
			for i = 1, 8 do
				applyRobloxPlusBadge(LocalPlayer.UserId, true, saved)
				task.wait(0.5)
			end
		end)
	else
		applyRobloxPlusBadge(LocalPlayer.UserId, false, saved)
	end

	if sourceInput ~= "" then
		local sourceUserId = resolveUserId(sourceInput)
		if sourceUserId then
			saved.sourceUserId = sourceUserId
			local sName, sDispName = cachedGetSourceNames(sourceUserId)
			saved.sourceName = sName or sourceInput
			saved.sourceDisplayName = sDispName or sName or sourceInput

			local character = LocalPlayer.Character
			if character and not getSelfNamesOnly() then
				task.spawn(function()
					local desc = cachedGetDescription(sourceUserId)
					if desc then applyDescriptionCustom(character, desc, sourceUserId) end
				end)
			end

			if saved.charAddedConn then saved.charAddedConn:Disconnect() end
			saved.charAddedConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
				local s = modifiedPlayers[LocalPlayer]
				if not isSpoofed or not s or not s.sourceUserId then return end

				clearAccessories(newChar)

				local h = newChar:WaitForChild("Humanoid", 10)
				if not h then return end
				task.spawn(function()
					pcall(function()
						local desc = not getSelfNamesOnly() and cachedGetDescription(s.sourceUserId) or nil
						for i = 1, 3 do
							if desc and not getSelfNamesOnly() then
								applyDescriptionCustom(newChar, desc, s.sourceUserId)
							end
							if s.sourceDisplayName then h.DisplayName = s.sourceDisplayName end
							task.wait(0.4)
						end
					end)
				end)
				task.spawn(function()
					for i = 1, 3 do
						local ok = applyIdentitySpoofing(LocalPlayer, s.sourceUserId, getSelfChangeUserId(), getSelfNamesOnly())
						if ok then break end
						task.wait(0.5)
					end
				end)
			end)

			task.spawn(function()
				for i = 1, 3 do
					local ok = applyIdentitySpoofing(LocalPlayer, sourceUserId, getSelfChangeUserId(), getSelfNamesOnly())
					if ok then break end
					task.wait(0.5)
				end
			end)
		else
			setStatus("Invalid UserID or Username", Color3.fromRGB(255, 120, 120))
			return
		end
	end

	if winsText ~= "" or elimText ~= "" then
		spoofLeaderstats(LocalPlayer, winsText, elimText, noScale)
	end

	if coinsText ~= "" or tokensText ~= "" then
		applyHudCurrency(coinsText, tokensText)
	end

	isSpoofed = true
	local statusMsg = (sourceInput ~= "" and ("Spoofed as " .. (saved.sourceDisplayName or sourceInput))) or (robloxPlus and "Applied Roblox Plus badge") or "Applied self changes"
	setStatus(statusMsg, Color3.fromRGB(120, 255, 120))
end)

