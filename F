local function findNameFrameForUser(userId)
	local targetIdStr = tostring(userId)
	local playerObj = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == userId then
			playerObj = p
			break
		end
	end

	local pl = CoreGui:FindFirstChild("PlayerList")
	if not pl then pcall(function() pl = CoreGui.PlayerList end) end

	if pl then
		local entry = pl:FindFirstChild("PlayerEntry_" .. targetIdStr, true)
		if entry then
			local nf = entry:FindFirstChild("NameFrame", true)
			if nf then return nf end
		end
		local ren = renamedEntries[userId]
		if ren then
			local rentry = pl:FindFirstChild(ren, true)
			if rentry then
				local nf = rentry:FindFirstChild("NameFrame", true)
				if nf then return nf end
			end
		end
		for _, nf in ipairs(pl:GetDescendants()) do
			if nf.Name == "NameFrame" and nf:IsA("Frame") then
				local anc = nf.Parent
				while anc and anc ~= pl do
					if anc.Name:find(targetIdStr, 1, true) or (ren and anc.Name:find(ren, 1, true)) then
						return nf
					end
					anc = anc.Parent
				end
				if playerObj then
					for _, child in ipairs(nf:GetChildren()) do
						if child:IsA("TextLabel") and (child.Text == playerObj.Name or child.Text == playerObj.DisplayName) then
							return nf
						end
					end
				end
			end
		end
	end

	local pe = findPlayerEntry(userId)
	if pe then
		local nf = pe:FindFirstChild("NameFrame", true)
		if nf then return nf end
	end

	for _, nf in ipairs(CoreGui:GetDescendants()) do
		if nf.Name == "NameFrame" and nf:IsA("Frame") then
			local anc = nf.Parent
			while anc and anc ~= CoreGui do
				if anc.Name:find(targetIdStr, 1, true) then
					return nf
				end
				anc = anc.Parent
			end
			if playerObj then
				for _, child in ipairs(nf:GetChildren()) do
					if child:IsA("TextLabel") and (child.Text == playerObj.Name or child.Text == playerObj.DisplayName) then
						return nf
					end
				end
			end
		end
	end
	return nil
end

local function applyRobloxPlusBadge(userId, enable, saved)
	local nf = findNameFrameForUser(userId)
	if not nf then return false end

	if enable then
		local icon = nf:FindFirstChild("PlayerIcon")
		if icon and icon:IsA("TextLabel") then
			icon.Text = "roblox-plus"
			icon.TextSize = 16
			icon.TextColor3 = Color3.fromRGB(213, 215, 221)
			icon.TextTransparency = 0
			icon.BackgroundTransparency = 1
			icon.Visible = true
			if RPLUS_FONT then pcall(function() icon.FontFace = RPLUS_FONT end) end
		else
			if icon and icon:IsA("ImageLabel") then
				icon.Visible = false
				icon.Name = "OriginalPlayerIcon"
			end
			local textIcon = nf:FindFirstChild("PlayerIcon")
			if not textIcon or not textIcon:IsA("TextLabel") then
				textIcon = Instance.new("TextLabel")
				textIcon.Name = "PlayerIcon"
				local orig = nf:FindFirstChild("OriginalPlayerIcon")
				if orig then
					textIcon.Size = orig.Size
					textIcon.Position = orig.Position
					textIcon.AnchorPoint = orig.AnchorPoint
					textIcon.LayoutOrder = orig.LayoutOrder
					textIcon.ZIndex = orig.ZIndex
				else
					textIcon.Size = UDim2.new(0, 16, 0, 16)
					textIcon.LayoutOrder = 1
				end
				textIcon.BackgroundTransparency = 1
				textIcon.TextXAlignment = Enum.TextXAlignment.Center
				textIcon.TextYAlignment = Enum.TextYAlignment.Center
				textIcon.Parent = nf
			end
			textIcon.Text = "roblox-plus"
			textIcon.TextSize = 16
			textIcon.TextColor3 = Color3.fromRGB(213, 215, 221)
			textIcon.TextTransparency = 0
			textIcon.Visible = true
			if RPLUS_FONT then pcall(function() textIcon.FontFace = RPLUS_FONT end) end
		end

		if saved and saved.identityConns and not saved.robloxPlusConn then
			saved.robloxPlusConn = nf.ChildAdded:Connect(function(c)
				if c.Name == "PlayerIcon" and not c:IsA("TextLabel") then
					task.defer(applyRobloxPlusBadge, userId, true, saved)
				end
			end)
			table.insert(saved.identityConns, saved.robloxPlusConn)
		end
	else
		local spoofed = nf:FindFirstChild("PlayerIcon")
		local orig = nf:FindFirstChild("OriginalPlayerIcon")
		if orig then
			if spoofed and spoofed:IsA("TextLabel") then
				pcall(function() spoofed:Destroy() end)
			end
			orig.Name = "PlayerIcon"
			orig.Visible = true
		elseif spoofed and spoofed:IsA("TextLabel") then
			spoofed.Text = ""
		end
	end
	return true
end

local function getTargetPlayer(input)
	if not input or input == "" then return nil end
	local clean = trimText(input):lower()
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower() == clean or player.DisplayName:lower() == clean then
			return player
		end
		local data = modifiedPlayers[player]
		if data and (
			(data.originalName and data.originalName:lower() == clean) or
			(data.originalDisplayName and data.originalDisplayName:lower() == clean) or
			(data.sourceName and data.sourceName:lower() == clean) or
			(data.sourceDisplayName and data.sourceDisplayName:lower() == clean)
		) then
			return player
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower():find(clean, 1, true) or player.DisplayName:lower():find(clean, 1, true) then
			return player
		end
	end
	local userId = tonumber(input)
	if userId then
		for _, player in ipairs(Players:GetPlayers()) do
			local data = modifiedPlayers[player]
			if player.UserId == userId or (data and data.originalUserId == userId) then
				return player
			end
		end
	else
		local success, foundId = pcall(function() return Players:GetUserIdFromNameAsync(input) end)
		if success and foundId then
			for _, player in ipairs(Players:GetPlayers()) do
				if player.UserId == foundId then return player end
			end
		end
	end
	return nil
end

local function getProfileRefs()
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then return nil end

	local profileCard = playerGui:FindFirstChild("ProfileCard") or playerGui:FindFirstChild("Profile")
	if not profileCard then
		for _, g in ipairs(playerGui:GetChildren()) do
			if g:IsA("ScreenGui") and g.Name ~= "AntipathyAV" then
				profileCard = g:FindFirstChild("ProfileCard") or g:FindFirstChild("Profile")
				if profileCard then break end
			end
		end
	end

	local refs = {
		timePlayed = nil,
		gamesPlayed = nil,
		winStreak = nil,
		ability = nil,
		abilityIcon = nil,
		killsAmount = nil,
		winsAmount = nil,
		rapAmount = nil,
		device = nil,
		country = nil
	}
	if not profileCard then return refs end

	local function findAchievementDesc(name)
		local ach = profileCard:FindFirstChild(name, true)
		if ach then
			local desc = ach:FindFirstChild("Description") or ach:FindFirstChild("Desc") or ach:FindFirstChildWhichIsA("TextLabel")
			if desc then
				if desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then
					return desc
				end
				local subLabel = desc:FindFirstChildWhichIsA("TextLabel") or desc:FindFirstChild("Amount") or desc:FindFirstChild("Value")
				if subLabel then return subLabel end
			end
		end
		return nil
	end

	refs.timePlayed = findAchievementDesc("Achievement01")
	refs.gamesPlayed = findAchievementDesc("Achievement02")
	refs.winStreak = findAchievementDesc("Achievement03")
	refs.ability = findAchievementDesc("Achievement04")

	local ach04 = profileCard:FindFirstChild("Achievement04", true)
	if ach04 then
		refs.abilityIcon = ach04:FindFirstChild("Icon") or ach04:FindFirstChild("ImageLabel") or ach04:FindFirstChild("Vector") or ach04:FindFirstChildWhichIsA("ImageLabel")
	end

	local function findStatElement(name)
		for _, desc in ipairs(profileCard:GetDescendants()) do
			if desc.Name:lower() == name:lower() then
				local amt = desc:FindFirstChild("Amount") or (desc:FindFirstChild("Frame") and desc.Frame:FindFirstChild("Amount")) or desc:FindFirstChild("Value") or desc:FindFirstChildWhichIsA("TextLabel")
				if amt then return amt end
				if desc:IsA("TextLabel") then return desc end
			end
		end
		return nil
	end

	refs.killsAmount = findStatElement("Kills") or findStatElement("Eliminations")
	refs.winsAmount = findStatElement("Wins")
	refs.rapAmount = findStatElement("Rap") or findStatElement("RAP")

	for _, desc in ipairs(profileCard:GetDescendants()) do
		local dName = desc.Name:lower()
		if dName == "device" or dName == "deviceicon" then
			if not refs.device and (desc:IsA("ImageLabel") or desc:IsA("ImageButton") or desc:IsA("TextLabel")) then
				refs.device = desc
			end
		elseif dName == "country" or dName == "countryflag" then
			if not refs.country and (desc:IsA("TextLabel") or desc:IsA("ImageLabel") or desc:IsA("ImageButton")) then
				refs.country = desc
			end
		elseif not refs.robloxPlus and (dName:find("premium") or dName:find("robloxplus") or dName == "plus" or dName == "plusicon" or dName:find("vip") or dName:find("verified")) then
			if desc:IsA("ImageLabel") or desc:IsA("ImageButton") or desc:IsA("Frame") then
				refs.robloxPlus = desc
			end
		end
	end

	return refs
end

local function findHudMoneyLabels()
	local results = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return results end

	local function addIfValid(el)
		if not el or not (el:IsA("TextLabel") or el:IsA("TextBox") or el:IsA("TextButton")) then return end
		for _, r in ipairs(results) do if r == el then return end end
		table.insert(results, el)
	end

	local hud = pg:FindFirstChild("HUD") or pg:FindFirstChild("Hud") or pg:FindFirstChild("MainHud")
	if hud then
		local leftFrame = hud:FindFirstChild("LeftFrame")
		local top = leftFrame and leftFrame:FindFirstChild("Top")
		local moneyFrame = top and (top:FindFirstChild("MoneyFrame") or top:FindFirstChild("CoinsFrame") or top:FindFirstChild("Money") or top:FindFirstChild("Coins"))
		if moneyFrame then
			local ml = moneyFrame:FindFirstChild("MoneyLabel") or moneyFrame:FindFirstChild("Amount") or moneyFrame:FindFirstChild("Value") or moneyFrame:FindFirstChildWhichIsA("TextLabel")
			addIfValid(ml)
		end

		for _, desc in ipairs(hud:GetDescendants()) do
			local dName = desc.Name:lower()
			if dName == "moneylabel" or dName == "coinlabel" or dName == "coinslabel" or dName == "cashlabel" then
				addIfValid(desc)
			elseif (dName == "amount" or dName == "value") and desc.Parent then
				local pName = desc.Parent.Name:lower()
				if pName:find("money") or pName:find("coin") or pName:find("cash") or pName:find("currency") or pName:find("gold") then
					addIfValid(desc)
				end
			elseif desc:IsA("TextLabel") and desc.Parent and (desc.Parent.Name:lower():find("money") or desc.Parent.Name:lower():find("coin")) then
				addIfValid(desc)
			end
		end
	end

	for _, screen in ipairs(pg:GetChildren()) do
		if screen:IsA("ScreenGui") and screen.Name ~= "AntipathyAV" and screen.Name ~= "Trade" and screen.Name ~= "TradeRequest" and screen.Name ~= "Trading" then
			for _, desc in ipairs(screen:GetDescendants()) do
				local dName = desc.Name:lower()
				if dName == "moneylabel" or dName == "coinlabel" then
					addIfValid(desc)
				elseif (dName == "amount" or dName == "value") and desc.Parent then
					local pName = desc.Parent.Name:lower()
					if pName == "moneyframe" or pName == "coinsframe" or pName == "money" or pName == "coins" or pName == "coin" then
						addIfValid(desc)
					end
				end
			end
		end
	end

	return results
end

local function findTradeTokenLabels()
	local results = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return results end

	local searchGuis = {
		pg:FindFirstChild("TradeRequest"),
		pg:FindFirstChild("Trade"),
		pg:FindFirstChild("Trading")
	}

	for _, tradeGui in ipairs(searchGuis) do
		if tradeGui then
			local main = tradeGui:FindFirstChild("Main", true) or tradeGui:FindFirstChild("Main")
			if main then
				local currency = main:FindFirstChild("Currency", true) or main:FindFirstChild("Currency")
				if currency then
					for _, name in ipairs({"Coins", "Tokens", "Coin", "Token"}) do
						local cObj = currency:FindFirstChild(name)
						if cObj then
							local amt = cObj:FindFirstChild("Amount") or cObj:FindFirstChild("Value") or cObj:FindFirstChildWhichIsA("TextLabel")
							if amt and (amt:IsA("TextLabel") or amt:IsA("TextBox")) then
								table.insert(results, amt)
							end
						end
					end
				end
			end
			for _, desc in ipairs(tradeGui:GetDescendants()) do
				if (desc.Name == "Amount" or desc.Name == "Value") and (desc:IsA("TextLabel") or desc:IsA("TextBox")) then
					local found = false
					for _, r in ipairs(results) do if r == desc then found = true; break end end
					if not found then table.insert(results, desc) end
				end
			end
		end
	end

	return results
end

local function lockTextElement(element, desiredText, originals, conns, fieldConns, key)
	if not element or not element.Parent then return end
	if originals[key] == nil then originals[key] = element.Text end
	if fieldConns[key] then
		pcall(function() fieldConns[key]:Disconnect() end)
		fieldConns[key] = nil
	end

	pcall(function()
		element.TextWrapped = true
		element.ClipsDescendants = false
		element.Text = desiredText
	end)

	local updating = false
	local conn = element:GetPropertyChangedSignal("Text"):Connect(function()
		if updating then return end
		if element.Text ~= desiredText then
			updating = true
			pcall(function()
				element.TextWrapped = true
				element.ClipsDescendants = false
				element.Text = desiredText
			end)
			updating = false
		end
	end)
	table.insert(conns, conn)
	fieldConns[key] = conn
end

local function lockImageElement(element, desiredImage, originals, conns, fieldConns, key)
	if not element or not element.Parent then return end
	if originals[key] == nil then originals[key] = element.Image end
	if fieldConns[key] then
		pcall(function() fieldConns[key]:Disconnect() end)
		fieldConns[key] = nil
	end

	pcall(function() element.Image = desiredImage end)

	local updating = false
	local conn = element:GetPropertyChangedSignal("Image"):Connect(function()
		if updating then return end
		if element.Image ~= desiredImage then
			updating = true
			pcall(function() element.Image = desiredImage end)
			updating = false
		end
	end)
	table.insert(conns, conn)
	fieldConns[key] = conn
end

local function lockDynamicNumberElement(element, desiredStr, originals, conns, fieldConns, offsets, key)
	if not element or not element.Parent then return end
	local desiredNum = tonumber(desiredStr)
	if not desiredNum then return end

	local currentVal = parseNumber(element.Text)
	if originals[key] == nil then originals[key] = element.Text end
	local offset = desiredNum - currentVal
	offsets[key] = offset

	if fieldConns[key] then
		pcall(function() fieldConns[key]:Disconnect() end)
		fieldConns[key] = nil
	end

	local updating = false
	local function applyValue()
		updating = true
		local cur = parseNumber(element.Text)
		local off = offsets[key] or 0
		local spoofed = cur + off
		pcall(function() element.Text = formatWithCommas(spoofed) end)
		updating = false
	end

	applyValue()

	local conn = element:GetPropertyChangedSignal("Text"):Connect(function()
		if updating then return end
		applyValue()
	end)
	table.insert(conns, conn)
	fieldConns[key] = conn
end

local function getViewedProfileIdentifier(profileCard)
	if not profileCard then return nil, nil end
	local viewedUserId = nil
	local viewedUsername = nil

	local nameLabel = profileCard:FindFirstChild("PlayerName", true) 
		or profileCard:FindFirstChild("Username", true) 
		or profileCard:FindFirstChild("UsernameLabel", true)
		or profileCard:FindFirstChild("NameLabel", true)
		or profileCard:FindFirstChild("Title", true)

	if nameLabel and (nameLabel:IsA("TextLabel") or nameLabel:IsA("TextBox")) then
		local t = trimText(nameLabel.Text)
		if t ~= "" and not t:lower():find("profile") and not t:lower():find("stats") then
			viewedUsername = t:gsub("^@", "")
		end
	end

	for _, img in ipairs(profileCard:GetDescendants()) do
		if img:IsA("ImageLabel") or img:IsA("ImageButton") then
			local imageStr = tostring(img.Image or "")
			local idMatch = imageStr:match("id=(%d+)") or imageStr:match("userIds=(%d+)") or imageStr:match("userId=(%d+)")
			if idMatch then
				viewedUserId = tonumber(idMatch)
				break
			end
		end
	end

	if viewedUsername and not viewedUserId then
		local p = Players:FindFirstChild(viewedUsername)
		if p then viewedUserId = p.UserId end
	end
	if viewedUserId and not viewedUsername then
		local p = Players:GetPlayerByUserId(viewedUserId)
		if p then viewedUsername = p.Name end
	end

	return viewedUserId, viewedUsername
end

local function getSpoofedOptsForCard(profileCard)
	if not profileCard or not profileSpoofState.active then return nil end
	local viewedUserId, viewedUsername = getViewedProfileIdentifier(profileCard)

	local isSelf = false
	if viewedUserId and viewedUserId == LocalPlayer.UserId then isSelf = true end
	if viewedUsername and viewedUsername:lower() == LocalPlayer.Name:lower() then isSelf = true end
	if not viewedUserId and not viewedUsername then isSelf = true end

	if isSelf and profileSpoofState.configuredProfiles["self"] then
		return profileSpoofState.configuredProfiles["self"]
	end

	if viewedUserId and profileSpoofState.configuredProfiles[viewedUserId] then
		return profileSpoofState.configuredProfiles[viewedUserId]
	end
	if viewedUsername and profileSpoofState.configuredProfiles[viewedUsername:lower()] then
		return profileSpoofState.configuredProfiles[viewedUsername:lower()]
	end

	return nil
end

local function updateProfileCard()
	if not profileSpoofState.active then return end
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then return end

	local profileCard = playerGui:FindFirstChild("ProfileCard") or playerGui:FindFirstChild("Profile")
	if not profileCard then
		for _, g in ipairs(playerGui:GetChildren()) do
			if g:IsA("ScreenGui") and g.Name ~= "AntipathyAV" then
				profileCard = g:FindFirstChild("ProfileCard") or g:FindFirstChild("Profile")
				if profileCard then break end
			end
		end
	end

	if not profileCard then return end

	local opts = getSpoofedOptsForCard(profileCard)
	if not opts then return end

	local refs = getProfileRefs()
	if not refs then return end

	local function applyText(el, val, formatter)
		if el and val ~= "" then
			el.TextWrapped = true
			el.ClipsDescendants = false
			local targetT = formatter(val)
			if el.Text ~= targetT then el.Text = targetT end
		end
	end
	applyText(refs.winsAmount, opts.wins, formatStatNumber)
	applyText(refs.killsAmount, opts.elims, formatStatNumber)
	applyText(refs.rapAmount, opts.rap, formatRapNumber)
	applyText(refs.timePlayed, opts.timePlayed, formatTimePlayedHours)
	applyText(refs.gamesPlayed, opts.gamesPlayed, formatStatNumber)
	applyText(refs.winStreak, opts.winStreak, formatStatNumber)

	local combAbility = formatAbilityDisplay(opts.ability, opts.abilityGames)
	applyText(refs.ability, combAbility, function(t) return t end)

	if opts.ability ~= "" and refs.abilityIcon then
		local abilityImg = resolveAbilityImage(opts.ability)
		if abilityImg and refs.abilityIcon.Image ~= abilityImg then refs.abilityIcon.Image = abilityImg end
	end

	if opts.device ~= "" and refs.device then
		local devAsset = resolveDeviceAsset(opts.device)
		if devAsset and (refs.device:IsA("ImageLabel") or refs.device:IsA("ImageButton")) and refs.device.Image ~= devAsset then
			refs.device.Image = devAsset
		end
	end

	if opts.country ~= "" and refs.country then
		local flag = countryCodeToFlag(opts.country) or opts.country
		if refs.country.Text ~= flag then refs.country.Text = flag end
	end
end

local function ensureProfileHooksAttached()
	if #profileSpoofState.conns > 0 then return end

	local activeRenderConn = nil
	local function setRenderHookActive(active)
		if active and not activeRenderConn then
			activeRenderConn = RunService.RenderStepped:Connect(function()
				if profileSpoofState.active then updateProfileCard() end
			end)
		elseif not active and activeRenderConn then
			pcall(function() activeRenderConn:Disconnect() end)
			activeRenderConn = nil
		end
	end

	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if playerGui then
		local function hookCard(card)
			if not card then return end
			if card.Visible then
				setRenderHookActive(true)
				updateProfileCard()
			end

			local visConn = card:GetPropertyChangedSignal("Visible"):Connect(function()
				if profileSpoofState.active then
					if card.Visible then
						setRenderHookActive(true)
						updateProfileCard()
					else
						setRenderHookActive(false)
					end
				else
					setRenderHookActive(false)
				end
			end)
			table.insert(profileSpoofState.conns, visConn)

			local function attachToDesc(desc)
				if desc:IsA("TextLabel") or desc:IsA("TextBox") then
					local conn = desc:GetPropertyChangedSignal("Text"):Connect(function()
						if profileSpoofState.active and card.Visible then updateProfileCard() end
					end)
					table.insert(profileSpoofState.conns, conn)
				elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
					local conn = desc:GetPropertyChangedSignal("Image"):Connect(function()
						if profileSpoofState.active and card.Visible then updateProfileCard() end
					end)
					table.insert(profileSpoofState.conns, conn)
				end
			end

			for _, d in ipairs(card:GetDescendants()) do attachToDesc(d) end
			local addConn = card.DescendantAdded:Connect(attachToDesc)
			table.insert(profileSpoofState.conns, addConn)
		end

		for _, g in ipairs(playerGui:GetChildren()) do
			if g:IsA("ScreenGui") and g.Name ~= "AntipathyAV" then
				local card = g:FindFirstChild("ProfileCard", true) or g:FindFirstChild("Profile", true)
				if card then hookCard(card) end
			end
		end

		local newGuiConn = playerGui.DescendantAdded:Connect(function(desc)
			if desc.Name == "ProfileCard" or desc.Name == "Profile" then
				hookCard(desc)
			end
		end)
		table.insert(profileSpoofState.conns, newGuiConn)
	end

	table.insert(profileSpoofState.conns, {
		Disconnect = function() setRenderHookActive(false) end
	})
end

local function applyProfileStats(opts)
	local mode = getProfileTargetMode and getProfileTargetMode() or "Self"
	local customTarget = getProfileAnotherText and getProfileAnotherText() or ""

	if mode == "Self" then
		profileSpoofState.configuredProfiles["self"] = opts
		profileSpoofState.configuredProfiles[LocalPlayer.UserId] = opts
		profileSpoofState.configuredProfiles[LocalPlayer.Name:lower()] = opts
	elseif mode == "Target" then
		local targetInput = trimText(targetBox.Text)
		if targetInput ~= "" then
			local targetPlayer = getTargetPlayer(targetInput)
			if targetPlayer then
				profileSpoofState.configuredProfiles[targetPlayer.UserId] = opts
				profileSpoofState.configuredProfiles[targetPlayer.Name:lower()] = opts
			end
			local num = tonumber(targetInput)
			if num then profileSpoofState.configuredProfiles[num] = opts end
			profileSpoofState.configuredProfiles[targetInput:lower()] = opts
		end
	elseif mode == "Another" then
		if customTarget ~= "" then
			local customPlayer = getTargetPlayer(customTarget)
			if customPlayer then
				profileSpoofState.configuredProfiles[customPlayer.UserId] = opts
				profileSpoofState.configuredProfiles[customPlayer.Name:lower()] = opts
			end
			local num = tonumber(customTarget)
			if num then profileSpoofState.configuredProfiles[num] = opts end
			profileSpoofState.configuredProfiles[customTarget:lower()] = opts
		end
	end

	profileSpoofState.active = true
	ensureProfileHooksAttached()
	updateProfileCard()
	return true, "Applied profile stats to " .. mode
end

