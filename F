local function resolveDeviceAsset(deviceText)
	local clean = trimText(deviceText):lower()
	if DEVICE_ASSETS[clean] then return DEVICE_ASSETS[clean] end
	if clean:find("pc") or clean:find("computer") or clean:find("desk") then return DEVICE_ASSETS.pc end
	if clean:find("mob") or clean:find("phone") or clean:find("ios") or clean:find("android") then return DEVICE_ASSETS.mobile end
	if clean:find("con") or clean:find("xbox") or clean:find("ps") or clean:find("playstation") then return DEVICE_ASSETS.console end
	if clean:find("tab") or clean:find("ipad") then return DEVICE_ASSETS.tablet end
	if tonumber(clean) or clean:find("rbxasset") then
		return clean:find("rbxasset") and clean or ("rbxassetid://" .. clean)
	end
	return nil
end

local function formatWithCommas(num)
	local n = math.floor(math.abs(tonumber(num) or 0))
	local s = tostring(n)
	local parts = {}
	while #s > 3 do
		table.insert(parts, 1, s:sub(-3))
		s = s:sub(1, -4)
	end
	table.insert(parts, 1, s)
	local formatted = table.concat(parts, ",")
	return (tonumber(num) and tonumber(num) < 0) and ("-" .. formatted) or formatted
end

local function formatStatNumber(num)
	local n = tonumber(num)
	if not n then return "" end
	return n > 999 and formatWithCommas(n) or tostring(math.floor(n))
end

local function formatRapNumber(num)
	local n = tonumber(num)
	if not n then return "" end
	local absVal = math.abs(n)
	if absVal >= 1000000000 then
		return string.format("%.1fB+", n / 1000000000)
	elseif absVal >= 1000000 then
		return string.format("%.1fM+", n / 1000000)
	elseif absVal >= 1000 then
		return string.format("%.1fK+", n / 1000)
	else
		return tostring(math.floor(n))
	end
end

local function formatAbilityDisplay(ability, games)
	local a = trimText(ability or "")
	local g = trimText(games or "")
	local gamesFormatted = ""
	if g ~= "" then
		if g:lower():find("game") then
			gamesFormatted = g
		else
			local n = tonumber(g)
			gamesFormatted = n and (formatWithCommas(math.floor(n)) .. " Games") or (g .. " Games")
		end
	end
	if a ~= "" and gamesFormatted ~= "" then
		return a .. "\n" .. gamesFormatted
	elseif a ~= "" then
		return a
	elseif gamesFormatted ~= "" then
		return gamesFormatted
	end
	return ""
end

local function formatTimePlayedHours(val)
	local s = trimText(tostring(val or ""))
	if s == "" then return "" end
	local num = tonumber(s:match("%d+"))
	if not num then return s end
	return formatWithCommas(num) .. " Hours"
end

local function countryCodeToFlag(code)
	if not code or code == "" then return nil end
	local clean = trimText(code):upper():gsub("%s+", "")
	local cc = COUNTRY_ALIASES[clean] or clean
	if #cc ~= 2 or not cc:match("^[A-Z][A-Z]$") then return nil end
	local b1 = cc:byte(1) - 65 + 0x1F1E6
	local b2 = cc:byte(2) - 65 + 0x1F1E6
	return utf8.char(b1, b2)
end

